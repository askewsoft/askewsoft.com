---
import type { CollectionEntry } from 'astro:content';
import Pill from './Pill.astro';

interface Props {
	contributor: CollectionEntry<'profiles'>;
}

const { data, id } = Astro.props.contributor;
---

<a class="card" href={`/profiles/${id}`}>
	<div class="title">{data.name}</div>
	<div class="tags">
		{data.tags?.map((tag) => (
			<Pill>{tag}</Pill>
		))}
	</div>
	<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
</a>

<style>
	.card {
		border-radius: 1.5rem;
		display: grid;
		font-family: var(--font-brand);
		grid-template: auto 1fr / auto 1fr;
		height: 22rem;
		overflow: hidden;
		position: relative;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.title {
		color: var(--gray-100);
		font-size: var(--text-lg);
		font-weight: 800;
		grid-area: 1 / 1 / 1 / 1;
		margin: 0.2rem;
		padding: 0.1rem 0.5rem;
		z-index: 1;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		grid-area: 3 / 1 / 3 / 3;
		margin: 0.5rem;
		padding: 0.25rem 1rem;
		z-index: 1;
	}

	img {
		grid-area: 1 / 1 / 4 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	@media (min-width: 50em) {
		.title {
			font-size: var(--text-xl);
			margin: 0.5rem;
			padding: 0.5rem 1rem;
		}
		.tags {
			grid-area: 3 / 1 / 3 / 3;
			margin: 1rem;
			padding: 0.5rem 1.5rem;
		}
		img {
			grid-area: 1 / 1 / 4 / 3;
		}
	}
</style>