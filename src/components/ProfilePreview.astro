---
import type { CollectionEntry } from 'astro:content';
import ProfileCard from './ProfileCard.astro';

interface Props {
	contributor: CollectionEntry<'profiles'>;
}

const { data, id } = Astro.props.contributor;
---

{data.url ? (
	<a class="card" href={data.url} target="_blank" rel="noopener noreferrer">
		<ProfileCard data={data} />
	</a>
) : (
	<div class="card">
		<ProfileCard data={data} />
	</div>
)}

<style>
	.card {
		border-radius: 1.5rem;
		display: grid;
		font-family: var(--font-brand);
		grid-template: auto 1fr / auto 1fr;
		height: 22rem;
		overflow: hidden;
		position: relative;
		text-decoration: none;
		transition: all 0.3s ease;
	}
</style>