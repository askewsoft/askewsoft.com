---
import type { CollectionEntry } from 'astro:content';
import Label from './Label.astro';
import Pill from './Pill.astro';

interface Props {
	project: CollectionEntry<'portfolio'>;
}

const { data, id } = Astro.props.project;
const detailAvailable = data.detailAvailable;
---

<a class="card" href={detailAvailable ? `/portfolio/${id}` : '#'}>
	<div class="title">{data.title}</div>
	<Label class="label">{data.label}</Label>
	<div class="description">{data.description}</div>
	<div class="tags">
		{data.tags?.map((tag) => (
			<Pill>{tag}</Pill>
		))}
	</div>
	<img src={data.img} alt={data.imgAlt || ''} loading="lazy" decoding="async" />
</a>

<style define:vars={{ pointerEvents: detailAvailable ? 'auto' : 'none' }}>
	.card {
		border-radius: 1.5rem;
		font-family: var(--font-brand);
		display: grid;
		grid-template-areas:
			'title label'
			'main main'
			'foot foot';
		height: 16rem;
		overflow: hidden;
		text-decoration: none;
		transition: all 0.3s ease;
		position: relative;
		pointer-events: var(--pointerEvents);
	}

	.title {
		color: var(--gray-800);
		font-size: var(--text-lg);
		font-weight: 800;
		grid-area: title;
		z-index: 2;
		margin: 0.25rem;
		padding: 0.25rem 0.5rem;
	}

	.label {
		grid-area: label;
		margin: 0 0.25rem;
		z-index: 2;
	}

	.description {
		color: var(--gray-800);
		font-size: var(--text-md);
		font-weight: 600;
		grid-area: main;
		z-index: 2;
		margin: 0.25rem;
		padding: 0.25rem 0.5rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		grid-area: foot;
		gap: 0.5rem;
		z-index: 2;
		margin: 0.25rem;
		padding: 0.25rem 0.5rem;
	}

	img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		z-index: 1;
		filter: blur(0.5rem);
	}

	@media (min-width: 55em) {
		.card {
			height: 22rem;
			grid-template-areas:
				'title title label'
				'main main main'
				'foot foot foot';
		}
		.title {
			font-size: var(--text-xl);
			margin: 0.5rem;
			padding: 0.5rem 1rem;
		}
		.description {
			font-size: var(--text-lg);
			margin: 1rem;
		   	padding: 0.5rem 1.5rem;
		}
		.tags {
			margin: 1rem;
			padding: 0.5rem 1.5rem;
		}
	}
</style>
