---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ProfilePreview from '../components/ProfilePreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const profiles = (await getCollection('profiles')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout title="Team | Askewsoft" description="Meet the humans behind Askewsoft">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Team"
				tagline="Learn more about the humans behind Askewsoft."
				align="center"
			>
			</Hero>
			<Grid variant="center">
				{
					profiles.map((profile) => (
						<li class="card">
							<ProfilePreview contributor={profile} />
						</li>
					))
				}
			</Grid>
		</main>
	</div>
</BaseLayout>