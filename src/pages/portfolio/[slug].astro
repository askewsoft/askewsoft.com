---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import LinkNewWindow from '../../components/LinkNewWindow.astro';

export async function getStaticPaths() {
	const projects = await getCollection('portfolio');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;

const screenshots = project.data.screenshots || [];
---

<BaseLayout
	title={`${project.data.title} | Askewsoft`}
	description={project.data.description}
>
	<div class="stack gap-8">
        <div class="wrapper back-link-wrapper">
            <a href="/portfolio/" class="back-link">← Back to Portfolio</a>
        </div>
		<main class="wrapper portfolio">
			<Hero
				title={project.data.title}
				tagline={project.data.description}
			>
				{project.data.img && (
					<img
						class="img-detail"
						src={project.data.imgDetail}
					/>
				)}
			</Hero>

			<article class="content">
				<div set:html={project.body} />
			</article>

			{(project.data.repo || project.data.website) && (
				<div class="url-container">
					{project.data.repo && (
						<LinkNewWindow href={project.data.repo} text="View on GitHub" />
					)}
					{project.data.website && (
						<LinkNewWindow href={project.data.website} text="View Website" />
					)}
				</div>
			)}

			{screenshots.length > 0 && (
				<div class="screenshots-container">
					{screenshots.map((screenshot) => (
						<img src={screenshot.img} alt={screenshot.imgAlt} style={`transform: scale(${screenshot.imgScale})`} />
					))}
				</div>
			)}
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style define:vars={{ imgScale: project.data.imgDetailScale || 1 }}>
	.portfolio {
		display: flex;
		flex-direction: column;
	}

	.img-detail {
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
		transform: scale(var(--imgScale));
	}

	.content {
		grid-column: 2 / 3;
		color: var(--gray-200);
		font-size: var(--text-md);
	}

	.back-link-wrapper {
		margin-bottom: 2rem;
	}

	.back-link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus {
		color: var(--gray-0);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	.url-container {
		grid-column: 2 / 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 2rem;
	}

	.screenshots-container {
		grid-column: 2 / 3;
		display: grid;
		grid-template-rows: repeat(3, 1fr);
	}

	@media (min-width: 55em) {
		.content {
			font-size: var(--text-lg);
		}

		.back-link-wrapper {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.back-link {
			grid-column-start: 2;
		}

		.portfolio {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.portfolio > :global(:first-child) {
			grid-column-start: 2;
		}

		.url-container {
			justify-content: center;
			flex-direction: row;
			gap: 3rem;
			margin-top: 2rem;
		}

		.screenshots-container {
			margin-top: 2rem;
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>